# ==============================================================================
# AttendanceX Frontend Environment Variables (.env.example)
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Base URL pointing to your backend API server
# - During local development: http://localhost:5000 (or leave empty to let Vite proxy handle /api)
# - In production on Vercel/Netlify: Set this in host Dashboard -> Environment Variables
#   to your deployed backend domain (e.g., https://attendancex-api.onrender.com)
VITE_API_URL=https://your-backend-api.onrender.com
